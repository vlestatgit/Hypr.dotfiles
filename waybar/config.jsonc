// ---------------- Waybar ---------------- >

{

    "layer"  : "top", // Layer of the bar
    "height" : 32,    // Height of the bar

    "modules-left"   : [ // Left side modules

        "custom/arch",
        "hyprland/workspaces"
    
    ],

    "modules-center" : [ "clock" ], // Center modules

    "modules-right"  : [ // Right side modules
        
        "power-profiles-daemon",
        "network",
        "bluetooth",
        "pulseaudio",
        "backlight",
        "battery"
    
    ],

    // Remove ""tooltip" : false" if you want to enable tooltips for all modules

    "custom/arch" : {

        "exec"     : "echo ''", // Your OS Logo
        "format"   : "{}",
        "interval" : "once",

        "on-click" : "$HOME/.config/rofi/menu.sh",

        "tooltip"  : false

    },

    "hyprland/workspaces" : {

        "format" : "{id}",

        "persistent-workspaces" : { "*": 5 }

    },

    "clock" : { "format" : "󰥔  {:%a %d %b  %H:%M}" }, // Your clock format

    "network" : {

        "format-wifi"         : "󰤨",
        "format-ethernet"     : "󰈀",
        "format-disconnected" : "󰤭",
        "format-disabled"     : "",

        "on-click"       : "$HOME/.config/rofi/menu/connections/wifi.sh",
        "on-click-right" : "nmcli radio wifi | grep -q 'enabled' && nmcli radio wifi off || nmcli radio wifi on",

        "tooltip"  : false

    },

    "bluetooth" : {

	    "format"           : "",
        "format-off"       : "󰂲",
	    "format-connected" : "",

        "on-click"       : "$HOME/.config/rofi/menu/connections/bluetooth.sh",
        "on-click-right" : "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on",

        "tooltip"  : false

    },

    "power-profiles-daemon" : {

        "format" : "{icon}",

        "format-icons" : {
            
            "performance" : "",
            "balanced"    : "",
            "power-saver" : ""

        },

        "tooltip"  : false

    },

    "pulseaudio" : {

        "format"       : "{icon} {volume}%", // Remove "{volume}%" to show only the icon
        "format-icons" : { "default" : [ "󰕿", "󰖀", "󰕾" ] },

        "scroll-step" : 1,

        // Remove the following lines if you don't want to change volume with mouse scroll

        "on-scroll-up"   : "pactl set-sink-volume @DEFAULT_SINK@ +5% && [ $(pactl get-sink-volume @DEFAULT_SINK@ | grep -Po '[0-9]+(?=%)' | head -n1) -gt 100 ] && pactl set-sink-volume @DEFAULT_SINK@ 100%",
        "on-scroll-down" : "pactl set-sink-volume @DEFAULT_SINK@ -5%",

        "tooltip"  : false

    },

    // (Only laptops usually have the next modules, remove them if it isn't your case)

    "backlight" : {

        "device" : "intel_backlight", // Your device name

        "format"       : "{icon} {percent}%", // Remove "{percent}%" to show only the icon
        "format-icons" : [ "󰃞", "󰃟", "󰃠" ],

        "scroll-step" : 1,

        // Remove the following lines if you don't want to change brightness with mouse scroll

        "on-scroll-up"   : "brightnessctl set +5%",
        "on-scroll-down" : "BRG=$(brightnessctl -m | cut -d, -f4 | tr -d '%'); [ \"$BRG\" -gt 5 ] && brightnessctl set 5%-",

        "tooltip"  : false

    },

    "battery" : {

        "states" : {

            "warning"  : 50,
            "critical" : 25
            
        },

        "format"          : "{icon} {capacity}%",

        "format-charging" : "󰂄 {capacity}%",
        "format-plugged"  : "󰂄 {capacity}%",

        "format-icons"    : [ "󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹" ],

        "tooltip"  : false
        
    }
    
}

