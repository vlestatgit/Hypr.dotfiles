// ---------------- Fast Fetch ---------------- >

{

  "$schema" : "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo" : {

    "source" : "arch_small",
    "color"  : { "1" : "blue" },

    "padding" : {

      "top"   : 1,
      "left"  : 2,
      "right" : 4

    }

  },

  "display" : {

    "separator" : " ",

    "color" : { "separator" : "white" }

  },

  "modules" : [

    "break",

    // -------- System --------

    {
      "type"     : "title",
      "key"      : "╭─ 󰌢 host   ",
      "keyColor" : "red"
    },

    {
      "type"     : "os",
      "key"      : "│   os     ",
      "keyColor" : "red"
    },

    {
      "type"     : "kernel",
      "key"      : "│   kernel ",
      "keyColor" : "red"
    },

    {
      "type"     : "wm",
      "key"      : "╰─ 󱂬 wm     ",
      "keyColor" : "red"
    },

    "break",

    // -------- Hardware --------

    {
      "type"     : "cpu",
      "key"      : "╭─ 󰻠 cpu    ",
      "keyColor" : "cyan"
    },
    
    {
      "type"     : "gpu",
      "key"      : "│  󰢮 gpu    ",
      "keyColor" : "blue"
    },

    {
      "type"     : "memory",
      "key"      : "│   ram    ",
      "keyColor" : "yellow"
    },

    {
      "type"     : "disk",
      "key"      : "╰─ 󰋊 disk   ",
      "keyColor" : "yellow"
    },

    "break",

    {
      "type"   : "colors",
      "symbol" : "circle"
    },

    "break"

  ]
  
}